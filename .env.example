# Register an application at https://cloud.ouraring.com/oauth/applications
# and set its redirect URI to exactly the value of OURA_REDIRECT_URI below.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8765/callback

# Optional: skip the OAuth flow entirely by pasting a bearer token you already hold.
# Takes precedence over the OAuth credentials above.
OURA_ACCESS_TOKEN=

# Renpho Health (unofficial API — your normal app login).
RENPHO_EMAIL=
RENPHO_PASSWORD=

# Optional: extra Renpho user ids to merge in, comma separated. Some accounts
# end up with several user ids behind one email address.
RENPHO_EXTRA_USER_IDS=
